# Accounts switch. Exactly "true" turns on accounts and sign-in; anything else keeps the site as it was.
NEXT_PUBLIC_AUTH_ENABLED=
# Supabase project URL (local stack: the "API URL" that `pnpm db:start` prints).
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key. Safe for the browser; row-level security does the protecting.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key. Server only: never prefix it with NEXT_PUBLIC_ and never commit its value.
SUPABASE_SECRET_KEY=
# Public address of the site (canonical URLs, sitemap, and whether search engines may index it).
NEXT_PUBLIC_SITE_URL=
